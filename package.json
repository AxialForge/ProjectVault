    "sql.js": "^1.13.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^2.1.8"
  },
  "allowScripts": {
    "electron@44.2.0": true,
    "electron-winstaller@5.4.0": true
  }
